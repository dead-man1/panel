{
  "title": "NX Insight",
  "description": "Which paths from your users' networks to your nodes still work, from NX Insight's /metrics: per node, inbound and client network (AS number and name; the ten busiest per inbound, the rest as `other`), never a client's address. Provisioned against the datasource uid `nx-prometheus`, like nx-fleet.json. These are estimates from counts, not proof: check a red line against a real user before you move anyone.",
  "uid": "nx-insight",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nx-prometheus"
        },
        "query": "label_values(insight_path_authed_15m, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "asn",
        "label": "Client network (AS)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nx-prometheus"
        },
        "query": "label_values(insight_path_authed_15m{node=~\"$node\"}, asn)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Reading the panel",
      "description": "Whether Insight's last read of the panel's path telemetry worked.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "insight_feed_up",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "no"
                },
                "1": {
                  "text": "yes"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Nodes counting",
      "description": "Nodes the panel lists as counting.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "insight_nodes_counting",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Degraded paths",
      "description": "Paths the detector marks degraded now: node, inbound and client network.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "insight_paths_degraded",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Networks cut off",
      "description": "Client networks with every path down on two or more nodes at once: a shutdown or a whitelist, not a block of yours.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(insight_asn_outage) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Tunnels down",
      "description": "Tunnels with no link now. Their relay's paths drop because of the tunnel; nothing on the relay is blocked.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(insight_tunnel_down) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Alerts, 24 h",
      "description": "Every alert Insight raised in the last day.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(insight_alerts_24h) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Paths: node, inbound and client network",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Success",
      "description": "Of the connections accepted in the last fifteen minutes, the share that authenticated, per node and client network. A blocked path falls; a quiet one has no line. A WireGuard endpoint accepts none it can be seen to and has no line here: see its handshakes below.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (node, asn, org) (insight_path_authed_15m{node=~\"$node\",asn=~\"$asn\",kind=\"inbound\"}) / sum by (node, asn, org) (insight_path_accepted_15m{node=~\"$node\",asn=~\"$asn\",kind=\"inbound\"}) > -1",
          "legendFormat": "{{node}} AS{{asn}} {{org}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.6
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Authenticated sessions",
      "description": "Sessions that authenticated in the last fifteen minutes, per node and client network; for a WireGuard endpoint, the handshakes that worked. A path that stops arriving drops here.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (node, asn, org) (insight_path_authed_15m{node=~\"$node\",asn=~\"$asn\"})",
          "legendFormat": "{{node}} AS{{asn}} {{org}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Failed before authenticating",
      "description": "Connections that failed the handshake or were cut before it, in the last fifteen minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (node, asn, org) (insight_path_failed_15m{node=~\"$node\",asn=~\"$asn\"})",
          "legendFormat": "{{node}} AS{{asn}} {{org}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cut within seconds",
      "description": "Of the authenticated sessions, the share cut within seconds having moved almost nothing: throttling, or a tunnel behind the node that has no link.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (node, asn, org) (insight_path_early_close_15m{node=~\"$node\",asn=~\"$asn\"}) / sum by (node, asn, org) (insight_path_authed_15m{node=~\"$node\",asn=~\"$asn\"}) > -1",
          "legendFormat": "{{node}} AS{{asn}} {{org}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Degraded paths",
      "description": "Each path the detector marks degraded, while it is.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "insight_path_degraded{node=~\"$node\",asn=~\"$asn\"}",
          "legendFormat": "{{node}} {{inbound}} AS{{asn}} {{org}} {{network}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 60,
            "lineWidth": 1,
            "drawStyle": "bars"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Tunnels, probing and alerts",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      }
    },
    {
      "type": "timeseries",
      "title": "Tunnels with no link",
      "description": "1 while a tunnel has no link, by tunnel and its relay node.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "expr": "insight_tunnel_down",
          "legendFormat": "{{tunnel}} (relay {{relay}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 60,
            "lineWidth": 1,
            "drawStyle": "bars"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Probe scores",
      "description": "Each endpoint's probing score over the last six hours: replayed handshakes and failures right after real users. At 40 an alert goes out.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 29
      },
      "targets": [
        {
          "expr": "insight_probe_score{node=~\"$node\"}",
          "legendFormat": "{{node}} {{inbound}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Alerts in the last 24 hours",
      "description": "By kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "nx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 29
      },
      "targets": [
        {
          "expr": "insight_alerts_24h",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
